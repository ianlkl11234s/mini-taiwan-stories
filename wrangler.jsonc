// Cloudflare Workers 部署設定（取代 Zeabur nginx；Zeabur 2026-12 停運）
// 內容為純靜態頁，由 scripts/build-dist.mjs 組成 dist/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-taiwan-stories",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // 沒有前端路由，不存在的路徑回 404（同 nginx）
    "not_found_handling": "none",
    // /articles/<slug> 自動補結尾斜線並服務 index.html（同 nginx 的 301）
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
